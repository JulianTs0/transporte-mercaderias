Object subclass: #Empresa	instanceVariableNames: 'razonSocial envios'	classVariableNames: ''	package: 'TP1 - PPR'!!Empresa methodsFor: 'propios' stamp: 'Julian 4/29/2024 20:10'!addEnvio: unEnvio		(unEnvio isKindOf: Envio) ifTrue: [ 		(self existeEnvioParaMes: unEnvio mes anio: unEnvio anio) ifFalse: [ envios add: unEnvio. ^ 'Envio agregado'] ifTrue: [ ^ 'Envio repetido' ]].! !!Empresa methodsFor: 'propios' stamp: 'Julian 4/29/2024 20:13'!existeEnvioParaMes:unMes anio:unAnio 	| res existeEnvio |	res:= false.	existeEnvio:= envios detect:[:x | (x mes = unMes) & (x anio = unAnio)] ifNone:[ nil ].	existeEnvio ifNotNil: [ res:= true ].	^res		! !!Empresa methodsFor: 'inicializacion' stamp: 'tg 4/26/2024 14:04'!initialize	razonSocial:=''.	envios:= OrderedCollection new.! !!Empresa methodsFor: 'acceso' stamp: 'TP1PPR 4/15/2024 18:50'!envios	^ envios! !!Empresa methodsFor: 'acceso' stamp: 'TP1PPR 4/15/2024 18:50'!razonSocial	^ razonSocial! !!Empresa methodsFor: 'modificacion' stamp: 'TP1PPR 4/15/2024 18:50'!envios: anObject	envios := anObject! !!Empresa methodsFor: 'modificacion' stamp: 'TP1PPR 4/15/2024 18:50'!razonSocial: anObject	razonSocial := anObject! !Object subclass: #Envio	instanceVariableNames: 'hojasRuta mes anio'	classVariableNames: ''	package: 'TP1 - PPR'!!Envio methodsFor: 'propios' stamp: 'Julian 4/29/2024 20:12'!costoTotalTransportarADestino: unDestino	| destinos sumatoria |	sumatoria:= 0.		destinos:= hojasRuta select: [ :x | x destino = unDestino ].	destinos do:[:x | sumatoria:= sumatoria + x transporte costoTotalCarga].		^sumatoria .	! !!Envio methodsFor: 'propios' stamp: 'Julian 4/29/2024 20:12'!listadoResumidoOrdenado	| hojasOrdenadas listado |		listado:= 'No se encontraron Hojas de Ruta'.	hojasOrdenadas:= hojasRuta asSortedCollection: [ :x :y | x transporte costoTotalCarga >= y transporte costoTotalCarga ].	hojasOrdenadas isNotEmpty ifTrue: [		listado:= 'Listado de Hojas de Ruta', String cr. 		hojasOrdenadas do:[:x | listado:= listado , ' Codigo: ', x codigo asString, ' Costo total carga: ', x transporte costoTotalCarga asString, String cr.]		].		^listado.		! !!Envio methodsFor: 'propios' stamp: 'Julian 4/29/2024 20:06'!cantidadHojasRutaConCantidadBultosEntre: unBulto y: otroBulto	| hojas |		hojas := hojasRuta select: [ :x | x transporte isKindOf: Aereo].	hojas := hojas select: [ :x | x transporte cantidadBultos between: unBulto and: otroBulto ].		^ hojas size.! !!Envio methodsFor: 'propios' stamp: 'tg 4/26/2024 15:47'!addHojaRuta: unaHojaRuta	(unaHojaRuta isKindOf: HojaDeRuta)		ifTrue: [(unaHojaRuta origen ~= unaHojaRuta destino) 			ifTrue: [hojasRuta add: unaHojaRuta]].! !!Envio methodsFor: 'modificacion' stamp: 'TP1PPR 4/15/2024 18:50'!mes: anObject	mes := anObject! !!Envio methodsFor: 'modificacion' stamp: 'TP1PPR 4/15/2024 18:56'!hojasRuta: anObject	hojasRuta := anObject! !!Envio methodsFor: 'modificacion' stamp: 'TP1PPR 4/15/2024 18:50'!anio: anObject	anio := anObject! !!Envio methodsFor: 'inicializacion' stamp: 'Julian 4/29/2024 19:42'!initialize 	hojasRuta:= OrderedCollection new.	mes:=''.	anio:=''.! !!Envio methodsFor: 'acceso' stamp: 'TP1PPR 4/15/2024 18:50'!mes	^ mes! !!Envio methodsFor: 'acceso' stamp: 'TP1PPR 4/15/2024 18:56'!hojasRuta	^ hojasRuta! !!Envio methodsFor: 'acceso' stamp: 'TP1PPR 4/15/2024 18:50'!anio	^ anio! !Object subclass: #HojaDeRuta	instanceVariableNames: 'codigo origen destino nombreCliente transporte'	classVariableNames: ''	package: 'TP1 - PPR'!!HojaDeRuta methodsFor: 'propios' stamp: 'Julian 4/29/2024 19:31'!asString		| msj |	msj := 'Cliente: ', nombreCliente, String cr,	'Codigo: ', codigo asString, String cr,	 'Destino: ', destino, String cr,	 'Origen: ', origen, String cr,	 'Transporte de la hoja de ruta: ', String cr, transporte asString.		^ msj.! !!HojaDeRuta methodsFor: 'acceso' stamp: 'TP1PPR 4/15/2024 18:44'!destino	^ destino! !!HojaDeRuta methodsFor: 'acceso' stamp: 'TP1PPR 4/15/2024 18:44'!transporte	^ transporte! !!HojaDeRuta methodsFor: 'acceso' stamp: 'TP1PPR 4/15/2024 18:44'!nombreCliente	^ nombreCliente! !!HojaDeRuta methodsFor: 'acceso' stamp: 'TP1PPR 4/15/2024 18:44'!codigo	^ codigo! !!HojaDeRuta methodsFor: 'acceso' stamp: 'TP1PPR 4/15/2024 18:44'!origen	^ origen! !!HojaDeRuta methodsFor: 'inicializacion' stamp: 'tg 4/26/2024 14:13'!initialize 	codigo:=0.	origen:=''.	destino:=''.	nombreCliente:=''.	transporte:= ''.! !!HojaDeRuta methodsFor: 'modificacion' stamp: 'TP1PPR 4/15/2024 18:44'!destino: anObject	destino := anObject! !!HojaDeRuta methodsFor: 'modificacion' stamp: 'TP1PPR 4/15/2024 18:44'!nombreCliente: anObject	nombreCliente := anObject! !!HojaDeRuta methodsFor: 'modificacion' stamp: 'TP1PPR 4/15/2024 18:44'!transporte: anObject	transporte := anObject! !!HojaDeRuta methodsFor: 'modificacion' stamp: 'TP1PPR 4/15/2024 18:44'!codigo: anObject	codigo := anObject! !!HojaDeRuta methodsFor: 'modificacion' stamp: 'TP1PPR 4/15/2024 18:44'!origen: anObject	origen := anObject! !Object subclass: #Transporte	instanceVariableNames: 'matricula precioBase nombre'	classVariableNames: ''	package: 'TP1 - PPR'!!Transporte methodsFor: 'acceso' stamp: 'TP1PPR 4/15/2024 18:22'!precioBase	^ precioBase! !!Transporte methodsFor: 'acceso' stamp: 'TP1PPR 4/15/2024 18:22'!matricula	^ matricula! !!Transporte methodsFor: 'acceso' stamp: 'TP1PPR 4/15/2024 18:22'!nombre	^ nombre! !!Transporte methodsFor: 'propios' stamp: 'lAU 4/18/2024 14:30'!costoTotalCarga	self subclassResponsibility .! !!Transporte methodsFor: 'propios' stamp: 'Julian 4/29/2024 19:30'!asString 	| msg |	msg:= 'Matricula del transporte: ', matricula, String cr,	'Nombre: ', nombre, String cr, 	'Precio base: ', precioBase asString, String cr.	^msg	! !!Transporte methodsFor: 'inicializacion' stamp: 'Franco 4/25/2024 14:25'!initialize 	matricula:=''.	nombre:=''.	precioBase:=0.0.! !!Transporte methodsFor: 'modificacion' stamp: 'TP1PPR 4/15/2024 18:22'!matricula: anObject	matricula := anObject! !!Transporte methodsFor: 'modificacion' stamp: 'TP1PPR 4/15/2024 18:22'!nombre: anObject	nombre := anObject! !!Transporte methodsFor: 'modificacion' stamp: 'TP1PPR 4/15/2024 18:22'!precioBase: anObject	precioBase := anObject! !Transporte subclass: #Aereo	instanceVariableNames: 'cantidadBultos'	classVariableNames: ''	package: 'TP1 - PPR'!!Aereo methodsFor: 'inicializacion' stamp: 'TP1PPR 4/15/2024 18:35'!initialize 	super initialize.	cantidadBultos:=0. ! !!Aereo methodsFor: 'propios' stamp: 'lAU 4/18/2024 14:32'!costoTotalCarga 	| costoTotal |	costoTotal:= precioBase + (250 * cantidadBultos).	^costoTotal.! !!Aereo methodsFor: 'propios' stamp: 'Julian 4/29/2024 19:30'!asString 		| msg |	msg:= super asString, 	'Cantidad de bultos: ', cantidadBultos asString.	^msg.! !!Aereo methodsFor: 'modificacion' stamp: 'TP1PPR 4/15/2024 18:32'!cantidadBultos: anObject	cantidadBultos := anObject! !!Aereo methodsFor: 'acceso' stamp: 'TP1PPR 4/15/2024 18:32'!cantidadBultos	^ cantidadBultos! !Transporte subclass: #Maritimo	instanceVariableNames: 'tipoBuque totalTonelada'	classVariableNames: ''	package: 'TP1 - PPR'!!Maritimo methodsFor: 'modificacion' stamp: 'TP1PPR 4/15/2024 18:33'!tipoBuque: anObject	tipoBuque := anObject! !!Maritimo methodsFor: 'modificacion' stamp: 'TP1PPR 4/15/2024 18:33'!totalTonelada: anObject	totalTonelada := anObject! !!Maritimo methodsFor: 'acceso' stamp: 'TP1PPR 4/15/2024 18:33'!tipoBuque	^ tipoBuque! !!Maritimo methodsFor: 'acceso' stamp: 'TP1PPR 4/15/2024 18:33'!totalTonelada	^ totalTonelada! !!Maritimo methodsFor: 'propios' stamp: 'Julian 4/29/2024 19:20'!costoTotalCarga 	| costoTotal seguro |	costoTotal:= precioBase + (450 * totalTonelada).	seguro:=  (tipoBuque = 1) | (tipoBuque = 3) ifTrue: [ (precioBase * 40) / 100 ]  															 ifFalse: [ (tipoBuque = 2) ifTrue: [ 1000 ] ifFalse: [ 0 ] ].	costoTotal:= costoTotal + seguro. 	^costoTotal.! !!Maritimo methodsFor: 'propios' stamp: 'Julian 4/29/2024 19:30'!asString 	| msg |	msg:= super asString, 	'Tipo de buque: ', tipoBuque asString, String cr,	 'Total de toneladas: ', totalTonelada asString.	^msg.! !!Maritimo methodsFor: 'inicializacion' stamp: 'TP1PPR 4/15/2024 18:44'!initialize 	super initialize.	tipoBuque:=0.	totalTonelada:=0.! !